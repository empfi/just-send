# Server Configuration
PORT=3456
HOST=0.0.0.0

# Optional public origin for the startup QR (for example behind a domain proxy).
# The host-provided SERVER_IP and SERVER_PORT are used when this is unset.
# PUBLIC_URL=https://just-send.example.com

# Optional metadata directory override (leave commented to use default ./data/metadata)
# METADATA_DIR=./data/metadata

# Maximum upload size in bytes (e.g. 50GB = 53687091200)
MAX_FILE_SIZE_BYTES=53687091200

# Console log levels: comma-separated combination of info, warn, error.
# Only errors are logged by default.
# LOG_LEVELS=error

# Workspace actions (both enabled by default)
# ALLOW_DELETE_WORKSPACE=true
# ALLOW_LEAVE_WORKSPACE=true

# Instance branding (restart the server after changing these)
# INSTANCE_NAME=Just Send
# INSTANCE_LOGO=client/public/favicon.svg
# INSTANCE_ACCENT_COLOR=#3b82f6
