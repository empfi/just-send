# Server Configuration
PORT=3456
HOST=0.0.0.0

# Public origin used in pairing links and QR codes. On Pelican this is
# derived automatically from SERVER_IP and SERVER_PORT.
# PUBLIC_URL=https://just-send.example.com

# Optional custom directory overrides (leave commented to use default ./data)
# UPLOAD_DIR=./data/uploads
# METADATA_DIR=./data/metadata

# Maximum upload size in bytes (e.g. 50GB = 53687091200)
MAX_FILE_SIZE_BYTES=53687091200
